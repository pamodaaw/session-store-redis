<FindBugsFilter>

    <!--
      The OSGi data holder deliberately hands out the live service objects it was given. These are
      singleton services registered by the service component, not value objects, so a defensive copy
      would hand out a different store than the one the container registered. The same reasoning
      applies to the unsynchronized instance getter: INSTANCE is a final field initialised at class
      load, so the getter has nothing to synchronize on.
    -->
    <Match>
        <Class name="org.wso2.carbon.identity.session.store.redis.internal.RedisSessionStoreDataHolder" />
        <Or>
            <Bug pattern="EI_EXPOSE_REP" />
            <Bug pattern="EI_EXPOSE_REP2" />
            <Bug pattern="MS_EXPOSE_REP" />
            <Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED" />
        </Or>
    </Match>

    <!--
      The user session DAO is constructed with the session data store it must share, so that both
      report the same view of Redis. Copying it would defeat the point of the injection.
    -->
    <Match>
        <Class name="org.wso2.carbon.identity.session.store.redis.dao.RedisUserSessionDAOImpl" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <!--
      The connection manager exposes the lettuce command interfaces of its shared connection by
      design. They are the connection, not a copyable value.
    -->
    <Match>
        <Class name="org.wso2.carbon.identity.session.store.redis.util.RedisConnectionManager" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

</FindBugsFilter>
